BIFROST_IMPLEMENTATION=mock
TAVILY_MODE=mock
# Reserved for Mohit's explicitly metered live implementation. Never use VITE_ for secrets.
TAVILY_API_KEY=
ALLOW_LIVE_REQUESTS=false
TAVILY_MAX_REQUESTS=0
# Optional operator-reviewed identity bindings. Never inferred by a model.
TAVILY_PRIMARY_SOURCES=[]
LANGUAGE_MODE=rules
# Separate extraction endpoint; llm requires LANGUAGE_MODE=bifrost and hosted consent/cap.
CLAIM_EXTRACTION_MODE=rules
# Optional evidence assessment; disabled until separately tested with real sources.
EVIDENCE_COMPARISON_MODE=rules
# Select gemini (primary) or groq explicitly; never automatic cross-provider fallback.
# Keep LANGUAGE_MODE=rules until account/model/schema checks are complete.
BIFROST_LLM_PROVIDER=gemini
BIFROST_LLM_ENDPOINT=http://127.0.0.1:8080
# Explicit provider/model route after verifying account access and free-tier pricing.
BIFROST_LLM_MODEL=
# New hosted default: one bounded 20s attempt, no retry; max configurable 30s.
BIFROST_LLM_TIMEOUT_MS=20000
BIFROST_LLM_VIRTUAL_KEY=
# Only confirm after checking provider dashboard: Free tier, billing disabled.
BIFROST_FREE_TIER_CONFIRMED=false
# Per running adapter instance; restarts reset it. Zero disables hosted requests.
BIFROST_LLM_MAX_REQUESTS=0
GEMINI_API_KEY=
GROQ_API_KEY=
# Deferred local-model settings retained for compatibility.
OLLAMA_ENDPOINT=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=8000
HOST=127.0.0.1
PORT=3001
DATA_DIR=.local/data
# Optional frontend-only offline development: VITE_API_MODE=mock npm run dev:web
