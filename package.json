{
  "name": "proofbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "implementations/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "practice": "node --import tsx scripts/practice.ts",
    "demo:verifier": "node --import tsx scripts/demo-verifier.ts",
    "smoke:api": "node --import tsx scripts/api-smoke.ts",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/server.js",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "test:ui": "playwright test",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "evaluate:verifier": "node --import tsx scripts/evaluate-verifier.ts",
    "benchmark:language": "node --import tsx scripts/benchmark-language.ts",
    "benchmark:bifrost": "node --env-file-if-exists=.env --import tsx scripts/benchmark-language.ts --bifrost",
    "benchmark:bifrost:offline": "node --import tsx scripts/benchmark-language.ts --bifrost-fixture",
    "bifrost:check": "node --env-file-if-exists=.env --import tsx scripts/check-bifrost.ts",
    "bifrost:prepare": "node --env-file-if-exists=.env --import tsx scripts/prepare-bifrost.ts",
    "bifrost:start": "node --env-file-if-exists=.env --import tsx scripts/start-bifrost.ts",
    "bifrost:models": "node --env-file-if-exists=.env --import tsx scripts/provider-models.ts",
    "bifrost:schema": "node --env-file-if-exists=.env --import tsx scripts/check-bifrost-schema.ts",
    "bifrost:check:claims": "node --env-file-if-exists=.env --import tsx scripts/check-bifrost-claims.ts",
    "bifrost:check:comparison": "node --env-file-if-exists=.env --import tsx scripts/check-bifrost-comparison.ts",
    "tavily:check:retrieval": "node --env-file-if-exists=.env --import tsx scripts/check-tavily-retrieval.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run evaluate && npm run build"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "zod": "^3.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "@playwright/test": "^1.56.0"
  }
}
