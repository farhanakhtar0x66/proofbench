{
  "name": "proofbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "implementations/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && esbuild apps/api/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/api/server.js",
    "start": "node --env-file-if-exists=.env dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "test:ui": "playwright test",
    "test:failover": "node --env-file-if-exists=.env --import tsx scripts/test-bifrost-failover.ts",
    "test:real-failover": "node --env-file-if-exists=.env --import tsx scripts/test-real-bifrost-failover.ts",
    "test:freshness": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-tavily-freshness.ts",
    "benchmark:strategies": "node --env-file-if-exists=.env --import tsx scripts/benchmark-strategies.ts",
    "benchmark:optimization": "node --env-file-if-exists=.env --import tsx scripts/benchmark-optimization.ts",
    "benchmark:graph:calibrate": "node --env-file-if-exists=.env --import tsx scripts/run-graph-repair.ts calibrate",
    "benchmark:graph:matrix": "node --env-file-if-exists=.env --import tsx scripts/run-graph-repair.ts matrix",
    "demonstrate:bifrost": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-bifrost-01.ts",
    "demonstrate:adaptive": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-adaptive-v1-1.ts",
    "demonstrate:adaptive:v1-2": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-adaptive-v1-2.ts",
    "demonstrate:adaptive:v1-3": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-adaptive-v1-3.ts",
    "demonstrate:adaptive:v1-4:live": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-adaptive-v1-4-live.ts",
    "demonstrate:adaptive:v1-5:live": "node --env-file-if-exists=.env --import tsx scripts/demonstrate-adaptive-v1-5-live.ts",
    "demonstrate:task10:live": "node --env-file-if-exists=.env --import tsx scripts/verify-live-task10.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run evaluate && npm run build"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "gpt-tokenizer": "^4.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tree-sitter-rust": "^0.24.0",
    "web-tree-sitter": "^0.27.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
